# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Browser requests use Next.js APIs; no Supabase anon key is needed.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Solana RPC Configuration
# Server-side RPC (used by monitoring/cron jobs)
# Use Helius for mainnet; replace the placeholder with your configured key.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Network: mainnet-beta, devnet, or testnet
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Client-side RPC (used by wallet adapter in browser)
# Can be same as SOLANA_RPC_URL or a different endpoint
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Self-serve program activation payments
# Regular users pay once to add a new shared program. Admin creation and
# subscribing to existing programs are free. The fee defaults to 5 when unset.
PROGRAM_ACTIVATION_FEE_USDC=5
# Defaults to mainnet USDC; the mint and both RPC URLs must use the same network.
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Optional owner wallet, returned as metadata; payments do not transfer here.
PAYMENT_TREASURY_WALLET=your_treasury_wallet_address
# Required payment destination: an existing USDC token account, not a wallet address.
PAYMENT_TREASURY_USDC_ACCOUNT=your_treasury_usdc_token_account

# Authentication
# Secret for JWT token signing (user authentication)
# REQUIRED - Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Cron Job Security
# Secret for protecting cron endpoints from unauthorized access
# Generate with: openssl rand -hex 32 or use any secure random string
CRON_SECRET=your_random_secret_for_cron_jobs

# Telegram Bot Configuration
# REQUIRED for Telegram notifications
# Create a bot via @BotFather on Telegram and get the bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Bot username (without @, e.g., "idlsentinel_bot")
TELEGRAM_BOT_USERNAME=your_bot_username

# App URL (required for Telegram connection links)
# For local development: http://localhost:3000
# For production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
